[Unit]
Description=ai-workspace 每日交接摘要同步
Documentation=https://github.com/jazzray/ai-workspace
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=__REPO_ROOT__
ExecStart=__REPO_ROOT__/tools/sync.sh
# systemd user service 的 PATH 同樣需要明確帶上 ~/.local/bin
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
