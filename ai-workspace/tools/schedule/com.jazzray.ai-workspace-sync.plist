<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jazzray.ai-workspace-sync</string>

  <key>ProgramArguments</key>
  <array>
    <string>__REPO_ROOT__/tools/sync.sh</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>__HOUR_NUM__</integer>
    <key>Minute</key><integer>__MINUTE_NUM__</integer>
  </dict>

  <!-- launchd 的 PATH 極簡，不明確設定就會找不到 ai-memory / gitleaks / git -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>WorkingDirectory</key>
  <string>__REPO_ROOT__</string>

  <key>StandardOutPath</key>
  <string>__REPO_ROOT__/.sync.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO_ROOT__/.sync.log</string>

  <!-- 載入時不要立刻跑；睡過頭的排程 launchd 會在喚醒後補跑 -->
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
